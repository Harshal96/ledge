{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["repositories", "labelsAny", "trustedTriageLabels"],
  "additionalProperties": false,
  "properties": {
    "repositories": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}},
    "labelsAny": {"type": "array", "items": {"type": "string"}},
    "trustedTriageLabels": {"type": "array", "items": {"type": "string"}},
    "trustedMaintainers": {"type": "array", "items": {"type": "string"}},
    "excludeLabels": {"type": "array", "items": {"type": "string"}},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "minimumScore": {"type": "integer", "minimum": 0, "maximum": 100},
    "createdSince": {"type": ["string", "null"]},
    "firstRun": {"type": "string", "enum": ["baseline", "notify-existing"]}
  }
}
