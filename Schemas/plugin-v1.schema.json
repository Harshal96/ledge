{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ledge plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "hostProtocol", "name", "runtime", "capabilities", "commands", "defaultCommand"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "hostProtocol": {"const": "1"},
    "name": {"type": "string", "minLength": 1},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["kind", "entry"], "properties": {"kind": {"const": "local.command"}, "entry": {"type": "string"}, "interpreter": {"type": "string"}}},
    "capabilities": {"type": "array", "items": {"enum": ["github.issues.read", "github.pullRequests.read", "state.readwrite", "events.publish"]}},
    "configSchema": {"type": "string"},
    "commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "defaultCommand": {"type": "string"}
  }
}
