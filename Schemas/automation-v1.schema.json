{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ledge automation configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "automations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "automations": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "plugin", "command"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "plugin": {"type": "string"}, "command": {"type": "string"},
        "connection": {"type": ["string", "null"]}, "enabled": {"type": "boolean", "default": false},
        "revision": {"type": "integer", "minimum": 1}, "timeoutSeconds": {"type": "integer", "minimum": 5, "maximum": 900, "default": 120},
        "config": {"type": "object"},
        "schedule": {"type": "object", "additionalProperties": false, "properties": {"cron": {"type": ["string", "null"]}, "intervalSeconds": {"type": ["integer", "null"], "minimum": 60}, "timezone": {"type": "string"}, "misfire": {"enum": ["skip", "run-latest"]}, "jitterSeconds": {"type": "integer", "minimum": 0, "maximum": 60}}},
        "delivery": {"type": "object", "additionalProperties": false, "required": ["surface", "mode"], "properties": {"surface": {"const": "notch"}, "mode": {"enum": ["off", "inbox", "digest", "immediate"]}, "quietHours": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}}}}
      }
    }}
  }
}
